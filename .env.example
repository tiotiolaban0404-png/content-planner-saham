# Content Planner & Scheduler — konfigurasi notifikasi (Telegram + Facebook)
# ------------------------------------------------------------------
# 🧪 JANGAN pernah di-commit. Isi .env dari nilai riil sesudah copy dari ini.
# ------------------------------------------------------------------

# ── Telegram Bot (opsional, sudah terpasang sebelumnya) ──────────────
# Buat bot di @BotFather → HTTP API Token (misal: 123456789:ABC-DEF...).
TELEGRAM_BOT_TOKEN=[REDACTED]
# chat_id pasien / admin. Untuk 1:1 bot chat, angka saja (e.g. 7401634640).
# Cek chat_id: chat ke bot di HP, lanjut /start, lalu bot nampilin nomor.
TELEGRAM_CHAT_ID=[REDACTED]

# ── Facebook Messenger Bot ──────────────────────────────────────────
# 1. Buat halaman Facebook (contoh: @SahamAlertBot)
# 2. Buat aplikasi di https://developers.facebook.com/ → Produk → Messenger
# 3. Ambil "Page Access Token" lalu isi di sini
# 4. Pastikan user mengirim chat ke halaman bot di FB (bukan aplikasi)
FACEBOOK_PAGE_ID=1234567890
FACEBOOK_PAGE_ACCESS_TOKEN=[REDACTED]
FACEBOOK_VERIFY_TOKEN=[REDACTED]
FACEBOOK_SEND_DELAY_SEC=2.0
