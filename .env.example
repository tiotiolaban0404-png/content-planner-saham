# --- Telegram Bot (dibuat di @BotFather, minta HTTP API Token) ---
# JANGAN pernah di-commit. Contoh: TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_BOT_TOKEN=[REDACTED]
# chat_id pasien / admin. Untuk 1:1 bot chat, angka saja (e.g. 7401634640).
# Cek chat_id: chat ke bot di HP, lanjut /start, lalu bot nampilin nomor.
TELEGRAM_CHAT_ID=[REDACTED]

# --- Rekan API (jika pindah ke Finnhub / provider lain) ---
# FINNHUB_API_KEY=[REDACTED]
# IDX_BROKER_HOST=https://localhost:8443
